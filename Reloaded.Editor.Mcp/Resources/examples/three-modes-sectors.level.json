         ]},
        {"id": "SectorWarehouse", "name": "Warehouse", "brief": "Steal the manifest or blow the fuel tanks", "briefDefend": "Protect the warehouse", "objectives": ["CargoManifest", "FuelTanks"], "required": 1,
