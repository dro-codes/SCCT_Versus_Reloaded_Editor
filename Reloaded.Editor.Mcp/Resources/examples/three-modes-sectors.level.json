           {"kind": "open", "target": "ControlShutter", "hold": true},
           {"kind": "announce", "title": "Control room open", "merc": "Fall back to the control room", "spy": "The control room is open", "seconds": 6}
         ]},
        {"id": "SectorControl", "name": "Control room", "brief": "Hack the mainframe", "briefDefend": "Protect the mainframe", "objectives": ["Mainframe"]}
      ]
