# tools/run_mcp_e2e.ps1 sends each step's request to Reloaded.Editor.Mcp.exe
# (the runner adds jsonrpc and id) and checks its response. ${name} is a value
# the runner sets (Repository, TestRoot, TestSystem, MapsEd, MapFile,
# ExampleSpec, EditorPid) or an earlier step saved; a string that is exactly
# ${name} keeps that value's type. Paths: a.b[0].c, list[*], list[?key=value],
# map['dotted.key']; _notifications lists what the server sent during the step.
{"name":"initialize","stopOnFail":true,"request":{"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"run_mcp_e2e","version":"1.0"}}},"expect":[{"path":"result.protocolVersion","equals":"2025-06-18"},{"path":"result.serverInfo.name","equals":"scct-reloaded"},{"path":"result.capabilities.tools","exists":true},{"path":"result.capabilities.resources","exists":true},{"path":"result.capabilities.prompts","exists":true}]}
{"name":"initialized","request":{"method":"notifications/initialized"}}
{"name":"tools/list","stopOnFail":true,"request":{"method":"tools/list"},"expect":[{"path":"result.tools","minLength":27,"message":"the server lists its 27 tools"},{"path":"result.tools[*].name","contains":"editor_status"},{"path":"result.tools[*].name","contains":"map_file"},{"path":"result.tools[*].name","contains":"level_build"},{"path":"result.tools[*].name","contains":"map_build"},{"path":"result.tools[*].name","contains":"map_validate"},{"path":"result.tools[*].name","contains":"map_query"},{"path":"result.tools[*].name","contains":"view_screenshot"},{"path":"result.tools[*].name","contains":"editor_restart"},{"path":"result.tools[*].name","contains":"editor_undo"},{"path":"result.tools[?name=level_build].inputSchema.properties.mode.enum","equals":["preview","apply"]},{"path":"result.tools[?name=map_query].annotations.readOnlyHint","equals":true},{"path":"result.tools[?name=level_build].outputSchema.type","equals":"object"}]}
{"name":"resources/read rules","request":{"method":"resources/read","params":{"uri":"scct://rules"}},"expect":[{"path":"result.contents[0].uri","equals":"scct://rules"},{"path":"result.contents[0].text","minLength":1000,"message":"scct://rules lists the wiki rules"}]}
{"name":"prompts/list","request":{"method":"prompts/list"},"expect":[{"path":"result.prompts[*].name","contains":"create_level_from_description"},{"path":"result.prompts[*].name","contains":"versus_starter"}]}
{"name":"editor_status","stopOnFail":true,"request":{"method":"tools/call","params":{"name":"editor_status","arguments":{"pid":"${EditorPid}"}}},"expect":[{"path":"result.isError","equals":false},{"path":"result.structuredContent.connected","equals":true,"message":"the server reaches the editor over its pipe"},{"path":"result.structuredContent.bridge.pid","equals":"${EditorPid}"},{"path":"result.structuredContent.settings.enabled","equals":true},{"path":"result.structuredContent.bridge.approval","equals":false},{"path":"result.structuredContent.state.open","equals":true}]}
{"name":"map_file new","stopOnFail":true,"timeoutSeconds":300,"request":{"method":"tools/call","params":{"name":"map_file","arguments":{"action":"new","discardUnsaved":true,"label":"e2e new map"}}},"expect":[{"path":"result.isError","equals":false},{"path":"result.structuredContent.state.open","equals":true},{"path":"result.structuredContent.state.mapFile","equals":"","message":"the new map has no file yet"}]}
{"name":"level_build versus-starter","stopOnFail":true,"progress":true,"timeoutSeconds":1800,"request":{"method":"tools/call","params":{"name":"level_build","arguments":{"path":"${ExampleSpec}","mode":"apply","build":"geometry","screenshot":true,"label":"e2e versus starter"}}},"expect":[{"path":"result.isError","equals":false},{"path":"result.structuredContent.mode","equals":"apply"},{"path":"result.structuredContent.map","equals":"VERSUS STARTER"},{"path":"result.structuredContent.findings.blocking","equals":0,"message":"the starter spec has no errors that block the build"},{"path":"result.structuredContent.counts.pieces","ge":8},{"path":"result.structuredContent.counts.actors","gt":0},{"path":"result.structuredContent.undo.call","type":"number","message":"the build is one MCP call that editor_undo can take back"},{"path":"result.structuredContent.steps","contains":"actors"},{"path":"result.content[?type=image].data","png":{"minEdge":16}},{"path":"_notifications[?method=notifications/progress]","minLength":1,"message":"the build reports progress"}],"save":{"buildCall":"result.structuredContent.undo.call"}}
{"name":"map_build all","timeoutSeconds":3600,"request":{"method":"tools/call","params":{"name":"map_build","arguments":{"what":"all","check":true,"label":"e2e build all"}}},"expect":[{"path":"result.isError","equals":false},{"path":"result.structuredContent.build.ok","equals":true},{"path":"result.structuredContent.mapcheck.rows","type":"array"},{"path":"result.structuredContent.mapcheck.summary.errors","type":"number"}]}
{"name":"map_validate release","timeoutSeconds":900,"request":{"method":"tools/call","params":{"name":"map_validate","arguments":{"profile":"release"}}},"expect":[{"path":"result.isError","equals":false},{"path":"result.structuredContent.summary.profile","equals":"release"},{"path":"result.structuredContent.summary.source","equals":"live"},{"path":"result.structuredContent.summary.errors","equals":0,"message":"the built starter breaks no wiki rule a release must keep (only warnings)"},{"path":"result.structuredContent.findings[*].severity","notContains":"error"}],"save":{"releaseWarnings":"result.structuredContent.summary.warnings"}}
{"name":"map_query summary (built)","request":{"method":"tools/call","params":{"name":"map_query","arguments":{"what":"summary"}}},"expect":[{"path":"result.isError","equals":false},{"path":"result.structuredContent.spawns.spy","ge":4},{"path":"result.structuredContent.spawns.merc","ge":4},{"path":"result.structuredContent.cameras.count","ge":3},{"path":"result.structuredContent.cameras.firstCams","equals":1},{"path":"result.structuredContent.story.missions","minLength":1}],"save":{"actorsBuilt":"result.structuredContent.actors.total","spyStarts":"result.structuredContent.spawns.spy","mercStarts":"result.structuredContent.spawns.merc","cameraCount":"result.structuredContent.cameras.count","missions":"result.structuredContent.story.missions"}}
{"name":"map_file save_as","timeoutSeconds":900,"request":{"method":"tools/call","params":{"name":"map_file","arguments":{"action":"save_as","path":"${MapFile}","overwrite":true,"label":"e2e save"}}},"expect":[{"path":"result.isError","equals":false},{"path":"result.structuredContent.file","matches":"(?i)MapsEd[\\\\/]${MapFile}\\.sdc$"}],"files":[{"path":"${MapsEd}\\${MapFile}.sdc","exists":true,"minBytes":1024}]}
{"name":"editor_restart","stopOnFail":true,"timeoutSeconds":900,"request":{"method":"tools/call","params":{"name":"editor_restart","arguments":{"save":true,"waitSeconds":300,"label":"e2e restart"}}},"expect":[{"path":"result.isError","equals":false,"message":"the editor closes, starts again through the launcher and reopens the saved map"},{"path":"result.structuredContent.pid","type":"number"},{"path":"result.structuredContent.pid","notEquals":"${EditorPid}"},{"path":"result.structuredContent.state.mapFile","matches":"(?i)${MapFile}\\.sdc$"}],"save":{"EditorPid":"result.structuredContent.pid"}}
{"name":"editor_status (restarted)","stopOnFail":true,"request":{"method":"tools/call","params":{"name":"editor_status","arguments":{"pid":"${EditorPid}"}}},"expect":[{"path":"result.isError","equals":false},{"path":"result.structuredContent.connected","equals":true},{"path":"result.structuredContent.bridge.pid","equals":"${EditorPid}"}]}
{"name":"map_query summary (reopened)","request":{"method":"tools/call","params":{"name":"map_query","arguments":{"what":"summary"}}},"expect":[{"path":"result.isError","equals":false},{"path":"result.structuredContent.map.file","matches":"(?i)${MapFile}\\.sdc$"},{"path":"result.structuredContent.map.dirty","equals":false},{"path":"result.structuredContent.actors.total","equals":"${actorsBuilt}","message":"the reopened map has every actor the build made"},{"path":"result.structuredContent.spawns.spy","equals":"${spyStarts}"},{"path":"result.structuredContent.spawns.merc","equals":"${mercStarts}"},{"path":"result.structuredContent.cameras.count","equals":"${cameraCount}"},{"path":"result.structuredContent.story.missions","equals":"${missions}"}]}
{"name":"view_screenshot","timeoutSeconds":300,"request":{"method":"tools/call","params":{"name":"view_screenshot","arguments":{"viewport":"perspective","maxEdge":1024}}},"expect":[{"path":"result.isError","equals":false},{"path":"result.structuredContent.viewport","equals":"perspective"},{"path":"result.content[?type=image].mimeType","equals":"image/png"},{"path":"result.content[?type=image].data","png":{"longestEdgeAtLeast":257},"message":"the screenshot is a PNG over 256 pixels"}]}
{"name":"map_changes_apply (one light)","request":{"method":"tools/call","params":{"name":"map_changes_apply","arguments":{"document":{"format":"scct.map-changes","version":2,"map":"*","description":"MCP e2e: one light for editor_undo to take back","operations":[{"op":"create","id":"E2eUndoLight","class":"Engine.Light","properties":{"Location":{"X":"0","Y":"0","Z":"160"}}}]},"label":"e2e one light"}}},"expect":[{"path":"result.isError","equals":false},{"path":"result.structuredContent.created[*].id","contains":"E2eUndoLight"},{"path":"result.structuredContent.undo.call","type":"number"}],"save":{"lightCall":"result.structuredContent.undo.call"}}
{"name":"map_query summary (with the light)","request":{"method":"tools/call","params":{"name":"map_query","arguments":{"what":"summary"}}},"expect":[{"path":"result.isError","equals":false},{"path":"result.structuredContent.actors.total","gt":"${actorsBuilt}"}]}
{"name":"editor_undo","request":{"method":"tools/call","params":{"name":"editor_undo","arguments":{"label":"e2e undo"}}},"expect":[{"path":"result.isError","equals":false},{"path":"result.structuredContent.op","equals":"undo.call","message":"editor_undo takes back the last MCP call by its number"},{"path":"result.structuredContent.result.call","equals":"${lightCall}"}]}
{"name":"map_query summary (undone)","request":{"method":"tools/call","params":{"name":"map_query","arguments":{"what":"summary"}}},"expect":[{"path":"result.isError","equals":false},{"path":"result.structuredContent.actors.total","equals":"${actorsBuilt}","message":"editor_undo restores the map as it was"},{"path":"result.structuredContent.map.canRedo","equals":true}]}
{"name":"editor_status (end)","request":{"method":"tools/call","params":{"name":"editor_status","arguments":{}}},"expect":[{"path":"result.isError","equals":false},{"path":"result.structuredContent.connected","equals":true}]}
