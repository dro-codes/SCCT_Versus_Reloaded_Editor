*3DSMAX_ASCIIEXPORT	200
*COMMENT "A crate"
*MATERIAL_LIST {
	*MATERIAL_COUNT 1
	*MATERIAL 0 {
		*MATERIAL_NAME "Wood"
	}
}
*GEOMOBJECT {
	*NODE_NAME "Crate"
	*MESH {
		*MESH_NUMVERTEX 4
		*MESH_NUMFACES 2
		*MESH_VERTEX_LIST {
			*MESH_VERTEX    0	-32.0000	-16.0000	0.0000
			*MESH_VERTEX    1	32.0000	-16.0000	0.0000
			*MESH_VERTEX    2	32.0000	16.0000	64.0000
			*MESH_VERTEX    3	-32.0000	16.0000	64.0000
		}
		*MESH_FACE_LIST {
			*MESH_FACE    0:    A:    0 B:    1 C:    2 AB:    1 BC:    1 CA:    0	 *MESH_SMOOTHING 1 	*MESH_MTLID 0
			*MESH_FACE    1:    A:    0 B:    2 C:    3 AB:    0 BC:    1 CA:    1	 *MESH_SMOOTHING 1 	*MESH_MTLID 0
		}
	}
}
